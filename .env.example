# .env.example - Variables de entorno para VISONS S.A.C. DB (Persistencia Políglota)
# Copiar este archivo a .env y completar los valores reales.
# NUNCA subir el archivo .env al repositorio.

# --- SQL Server ---
SA_PASSWORD=SuperSecretPass123!
MSSQL_SA_PASSWORD=SuperSecretPass123!
MSSQL_DATABASE=Visons
SQL_HOST=sqlserver
SQL_HOST_PORT=1433

# --- MongoDB ---
MONGO_ADMIN_USER=admin
MONGO_ADMIN_PASSWORD=adminpassword
MONGO_DATABASE=Visons
MONGO_HOST=mongodb
MONGO_HOST_PORT=27017

# --- Puertos / Contenedor Check ---
HTTP_PORT=9090
TARGET_SCHEMA_VERSION=latest

# --- CI/CD ---
GIT_SHA=local
RELEASE_VERSION=0.0.0-local
